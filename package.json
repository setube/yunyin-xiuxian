{
  "name": "yunyin-xiuxian",
  "private": true,
  "version": "1.33.0",
  "type": "module",
  "description": "云隐修仙录——一款文字修仙放置游戏",
  "author": "谦君",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "test:report": "bun scripts/test-report.mjs",
    "type-check": "vue-tsc -b",
    "check": "bun run type-check && bun run lint",
    "build:electron": "vue-tsc -b && vite build && esbuild electron/main.js --bundle --platform=node --format=esm --outfile=dist-electron/main.js --external:electron && esbuild electron/preload.js --bundle --platform=node --format=cjs --outfile=dist-electron/preload.js --external:electron && electron-builder",
    "build:android": "bun run build && bunx cap sync android",
    "build:apk": "bun run build:android && cd android && ./gradlew assembleRelease"
  },
  "dependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/core": "^8.1.0",
    "@capacitor/filesystem": "^8.1.2",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.1.1",
    "file-saver": "^2.0.5",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.1",
    "pinia-plugin-persistedstate": "^4.2.0",
    "tone": "^15.1.22",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^22.13.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitejs/plugin-legacy": "^7.2.1",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.5.4",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.12",
    "eslint": "^9.20.0",
    "eslint-plugin-vue": "^9.32.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^7.2.4",
    "vitest": "^3.0.5",
    "vue-tsc": "^2.2.0"
  },
  "browserslist": [
    "Chrome >= 51",
    "Android >= 7",
    "iOS >= 12",
    "Safari >= 12"
  ],
  "build": {
    "appId": "games.wenzi.yunyin",
    "productName": "云隐修仙录",
    "asar": false,
    "files": [
      "dist-electron/**/*",
      "dist/**/*",
      "public/**/*",
      "package.json"
    ],
    "directories": {
      "output": "pkg"
    },
    "win": {
      "target": "zip",
      "icon": "public/favicon.ico",
      "artifactName": "yunyin-${version}-win.${ext}"
    }
  }
}
